{
	"name": "car-service",
	"type": "module",
	"version": "6.0.0",
	"private": true,
	"engineStrict": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"watch": "vite build --watch",
		"build": "time npm run lint && vite build",
		"build:ci": "vite build",
		"build-initial": "npm run lint && vite build -m initial",
		"deploy-layout": "dotenv -- sh -c 'time npm run lint && vite build -m deploy && time rsync -az --delete --progress dist/ html.xpager.ru@html.xpager.ru:/srv/www/html.xpager.ru/htdocs/public/$VITE_APP_NAME'",
		"lint": "eslint --fix && vue-tsc -b && stylelint . --fix",
		"lint:ci": "eslint && vue-tsc -b && stylelint .",
		"generate:favicons": "node scripts/generate-favicons.mjs",
		"hooks:install": "sh ./config/install-git-hooks.sh",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:deploy": "dotenv -- sh -c 'time vitepress build -m deploy docs && time rsync -az --delete --progress docs/.vitepress/dist/ html.xpager.ru@html.xpager.ru:/srv/www/html.xpager.ru/htdocs/public/$VITE_APP_DOCS_NAME'",
		"postinstall": "npm run hooks:install"
	},
	"dependencies": {
		"@aejkatappaja/phantom-ui": "1.4.0",
		"@lucide/vue": "^1.24.0",
		"@popperjs/core": "2.11.8",
		"@regle/core": "1.28.3",
		"@regle/rules": "1.28.3",
		"@vueform/multiselect": "2.6.11",
		"@vueform/slider": "2.1.10",
		"@vueform/toggle": "2.1.4",
		"@vuepic/vue-datepicker": "14.0.0",
		"@vueuse/core": "14.3.0",
		"@vueuse/integrations": "14.3.0",
		"axios": "1.18.1",
		"dexie": "^4.4.4",
		"floating-vue": "5.2.2",
		"lodash-es": "4.18.1",
		"maska": "3.2.0",
		"pinia": "3.0.4",
		"swiper": "14.0.2",
		"universal-cookie": "8.1.2",
		"vue": "3.5.39",
		"vue-router": "5.1.0",
		"vue-yandex-maps": "3.0.4",
		"vue3-otp-input": "0.5.40",
		"vue3-toastify": "0.2.9"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.1.0",
		"@spiriit/vite-plugin-svg-spritemap": "7.0.0",
		"@stylistic/stylelint-config": "5.0.0",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.20.1",
		"@types/postcss-functions": "4.0.4",
		"@types/postcss-pxtorem": "6.1.0",
		"@types/pug": "2.0.10",
		"@vitejs/plugin-vue": "6.0.7",
		"@vituum/vite-plugin-juice": "2.0.1",
		"@vue/tsconfig": "0.9.1",
		"autoprefixer": "10.5.2",
		"dotenv-cli": "11.0.0",
		"eslint": "10.6.0",
		"lightningcss": "1.32.0",
		"postcss": "8.5.16",
		"postcss-functions": "4.0.2",
		"postcss-html": "1.8.1",
		"postcss-pxtorem": "6.1.0",
		"postcss-sass": "0.5.0",
		"pug": "3.0.4",
		"sass-embedded": "1.100.0",
		"sharp": "^0.35.3",
		"stylelint": "17.14.0",
		"stylelint-config-html": "1.1.0",
		"stylelint-config-recommended-scss": "17.0.1",
		"stylelint-config-recommended-vue": "1.6.1",
		"stylelint-order": "8.1.1",
		"sugarss": "5.0.1",
		"svgo": "4.0.1",
		"terser": "5.48.0",
		"to-ico": "^1.1.5",
		"typescript": "6.0.3",
		"unocss": "^66.7.5",
		"unplugin-fonts": "2.0.0",
		"vite": "8.1.3",
		"vite-plugin-pwa": "^1.3.0",
		"vitepress": "1.6.4",
		"vue-tsc": "3.3.7",
		"workbox-window": "^7.4.1"
	},
	"browserslist": [
		"last 2 years",
		"not dead"
	]
}
